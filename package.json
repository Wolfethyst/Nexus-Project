{
  "name": "nexus-monorepo",
  "version": "2.0.0",
  "description": "Nexus - Streaming Platform Dashboard",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
